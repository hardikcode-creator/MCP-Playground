{
  "id": "collector-charts",
  "version": 1,
  "name": "Collector end-to-end: discover DBs/metadata -> list clusters/VMs -> drill into a cluster, its hosts and a VM -> pull perf + capacity chart specs -> render line & pie images via AntV. Exercises all 19 collector tools across 6 layers with cross-node $refs and 3 breakpoints.",
  "nodes": [
    {
      "id": "n_health",
      "tool": "collector__get_health",
      "args": {},
      "dependsOn": [],
      "breakpoint": false
    },
    {
      "id": "n_databases",
      "tool": "collector__get_listdatabases",
      "args": {},
      "dependsOn": [],
      "breakpoint": false
    },
    {
      "id": "n_metadata",
      "tool": "collector__get_metadata",
      "args": {},
      "dependsOn": [],
      "breakpoint": true
    },
    {
      "id": "n_clusters",
      "tool": "collector__get_listclusters",
      "args": {},
      "dependsOn": [],
      "breakpoint": false
    },
    {
      "id": "n_vms",
      "tool": "collector__get_listvms",
      "args": {},
      "dependsOn": [],
      "breakpoint": false
    },
    {
      "id": "n_cluster",
      "tool": "collector__get_cluster",
      "args": {
        "cluster_moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        }
      },
      "dependsOn": ["n_clusters"],
      "breakpoint": true
    },
    {
      "id": "n_cluster_perf",
      "tool": "collector__get_clusterperf",
      "args": {
        "cluster_moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        }
      },
      "dependsOn": ["n_clusters"],
      "breakpoint": false
    },
    {
      "id": "n_hosts",
      "tool": "collector__get_listhosts",
      "args": {
        "cluster_moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        }
      },
      "dependsOn": ["n_clusters"],
      "breakpoint": false
    },
    {
      "id": "n_host",
      "tool": "collector__get_host",
      "args": {
        "host_id": {
          "$ref": { "nodeId": "n_hosts", "path": "$.structuredContent.data.api_response[0].host_id" }
        }
      },
      "dependsOn": ["n_hosts"],
      "breakpoint": false
    },
    {
      "id": "n_host_perf",
      "tool": "collector__get_hostperf",
      "args": {
        "host_id": {
          "$ref": { "nodeId": "n_hosts", "path": "$.structuredContent.data.api_response[0].host_id" }
        }
      },
      "dependsOn": ["n_hosts"],
      "breakpoint": false
    },
    {
      "id": "n_vm",
      "tool": "collector__get_vm",
      "args": {
        "vm_id": {
          "$ref": { "nodeId": "n_vms", "path": "$.structuredContent.data.api_response[0].vm_id" }
        }
      },
      "dependsOn": ["n_vms"],
      "breakpoint": false
    },
    {
      "id": "n_vm_perf",
      "tool": "collector__get_vmperf",
      "args": {
        "vm_id": {
          "$ref": { "nodeId": "n_vms", "path": "$.structuredContent.data.api_response[0].vm_id" }
        }
      },
      "dependsOn": ["n_vms"],
      "breakpoint": false
    },
    {
      "id": "n_cluster_line",
      "tool": "collector__get_clusterlinechart",
      "args": {
        "moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        }
      },
      "dependsOn": ["n_cluster_perf"],
      "breakpoint": false
    },
    {
      "id": "n_host_line",
      "tool": "collector__get_hostlinechart",
      "args": {
        "host_id": {
          "$ref": { "nodeId": "n_hosts", "path": "$.structuredContent.data.api_response[0].host_id" }
        }
      },
      "dependsOn": ["n_host_perf"],
      "breakpoint": false
    },
    {
      "id": "n_vm_line",
      "tool": "collector__get_vmlinechart",
      "args": {
        "vm_id": {
          "$ref": { "nodeId": "n_vms", "path": "$.structuredContent.data.api_response[0].vm_id" }
        }
      },
      "dependsOn": ["n_vm_perf"],
      "breakpoint": false
    },
    {
      "id": "n_cluster_pie",
      "tool": "collector__get_clustercapacitypie",
      "args": {
        "moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        },
        "resource": "storage"
      },
      "dependsOn": ["n_cluster"],
      "breakpoint": false
    },
    {
      "id": "n_host_pie",
      "tool": "collector__get_hostcapacitypie",
      "args": {
        "host_id": {
          "$ref": { "nodeId": "n_hosts", "path": "$.structuredContent.data.api_response[0].host_id" }
        }
      },
      "dependsOn": ["n_host"],
      "breakpoint": false
    },
    {
      "id": "n_clusters_pie",
      "tool": "collector__get_clusterscapacitypie",
      "args": {
        "resource": "storage"
      },
      "dependsOn": ["n_clusters"],
      "breakpoint": false
    },
    {
      "id": "n_containers_pie",
      "tool": "collector__get_clusterstoragecontainerspie",
      "args": {
        "moid": {
          "$ref": { "nodeId": "n_clusters", "path": "$.structuredContent.data.api_response[0].moid" }
        },
        "metric": "storage_consumed"
      },
      "dependsOn": ["n_cluster"],
      "breakpoint": false
    },
    {
      "id": "n_viz_cluster_line",
      "tool": "chart__generate_line_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_cluster_line", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_cluster_line", "path": "$.structuredContent.data.api_response.title" }
        },
        "axisXTitle": "time",
        "axisYTitle": {
          "$ref": { "nodeId": "n_cluster_line", "path": "$.structuredContent.data.api_response.axisYTitle" }
        }
      },
      "dependsOn": ["n_cluster_line"],
      "breakpoint": true
    },
    {
      "id": "n_viz_host_line",
      "tool": "chart__generate_line_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_host_line", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_host_line", "path": "$.structuredContent.data.api_response.title" }
        },
        "axisXTitle": "time"
      },
      "dependsOn": ["n_host_line"],
      "breakpoint": false
    },
    {
      "id": "n_viz_vm_line",
      "tool": "chart__generate_line_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_vm_line", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_vm_line", "path": "$.structuredContent.data.api_response.title" }
        },
        "axisXTitle": "time"
      },
      "dependsOn": ["n_vm_line"],
      "breakpoint": false
    },
    {
      "id": "n_viz_cluster_pie",
      "tool": "chart__generate_pie_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_cluster_pie", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_cluster_pie", "path": "$.structuredContent.data.api_response.title" }
        }
      },
      "dependsOn": ["n_cluster_pie"],
      "breakpoint": false
    },
    {
      "id": "n_viz_host_pie",
      "tool": "chart__generate_pie_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_host_pie", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_host_pie", "path": "$.structuredContent.data.api_response.title" }
        }
      },
      "dependsOn": ["n_host_pie"],
      "breakpoint": false
    },
    {
      "id": "n_viz_clusters_pie",
      "tool": "chart__generate_pie_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_clusters_pie", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_clusters_pie", "path": "$.structuredContent.data.api_response.title" }
        }
      },
      "dependsOn": ["n_clusters_pie"],
      "breakpoint": false
    },
    {
      "id": "n_viz_containers_pie",
      "tool": "chart__generate_pie_chart",
      "args": {
        "data": {
          "$ref": { "nodeId": "n_containers_pie", "path": "$.structuredContent.data.api_response.data" }
        },
        "title": {
          "$ref": { "nodeId": "n_containers_pie", "path": "$.structuredContent.data.api_response.title" }
        }
      },
      "dependsOn": ["n_containers_pie"],
      "breakpoint": false
    }
  ]
}
