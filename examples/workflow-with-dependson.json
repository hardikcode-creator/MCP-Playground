{
  "id": "workflow-with-dependson",
  "version": 1,
  "name": "Demonstrates an ordering-only edge via dependsOn (no $ref between A and B)",
  "nodes": [
    {
      "id": "step_a",
      "tool": "everything__echo",
      "args": { "message": "A: prepare resource" },
      "dependsOn": ["step_a2"]
    },
    {
      "id": "step_a",
      "tool": "everything__echo",
      "args": { "message": "A2: prepare resource" },
      "dependsOn": ["step_a"]
    },
    {
      "id": "step_b",
      "tool": "everything__echo",
      "args": { "message": "B: must run AFTER A even though it doesn't use A's output" },
      "dependsOn": ["step_a"]
    },
    {
      "id": "step_c",
      "tool": "everything__echo",
      "args": {
        "message": {
          "$ref": { "nodeId": "step_b", "path": "$.content[0].text" }
        }
      }
    }
  ]
}
