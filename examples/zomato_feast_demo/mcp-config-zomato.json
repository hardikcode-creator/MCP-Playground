{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    },
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    },
    "zomato-mcp": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp-server.zomato.com/mcp"]
    }
  }
}
