{
  "id": "zomato-feast-25",
  "version": 1,
  "name": "Zomato feast finder (25 nodes): resolve saved address, then fan-out keyword searches via $ref address_id, with breakpoints",
  "nodes": [
    {
      "id": "addr",
      "tool": "zomato-mcp__get_saved_addresses_for_user",
      "args": {},
      "breakpoint": true
    },
    {
      "id": "pizza",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "pizza",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
