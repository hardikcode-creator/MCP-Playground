{
  "id": "multi-layered-26",
  "version": 1,
  "name": "Multi-MCP (everything + zomato) 26-node DAG: cross-server $refs, 5 breakpoints, fan-out + fan-in. No tokens required.",
  "nodes": [
    {
      "id": "start",
      "tool": "everything__echo",
      "args": { "message": "Outing planner started" },
      "breakpoint": true
    },
    {
      "id": "addr",
      "tool": "zomato-mcp__get_saved_addresses_for_user",
      "args": {},
      "breakpoint": true
    },
    {
      "id": "addr_view",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "addr", "path": "$.content[0].text" } } }
    },
    {
      "id": "s_pizza",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "pizza",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "s_sushi",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "sushi",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "s_biryani",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "biryani",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "s_burger",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "burger",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "s_chinese",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "chinese",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "s_dessert",
      "tool": "zomato-mcp__get_restaurants_for_keyword",
      "args": {
        "keyword": "desserts",
        "address_id": { "$ref": { "nodeId": "addr", "path": "$.structuredContent.result.addresses[0].address_id" } }
      },
      "dependsOn": ["addr"]
    },
    {
      "id": "r_pizza",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_pizza", "path": "$.content[0].text" } } },
      "breakpoint": true
    },
    {
      "id": "r_sushi",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_sushi", "path": "$.content[0].text" } } }
    },
    {
      "id": "r_biryani",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_biryani", "path": "$.content[0].text" } } }
    },
    {
      "id": "r_burger",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_burger", "path": "$.content[0].text" } } }
    },
    {
      "id": "r_chinese",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_chinese", "path": "$.content[0].text" } } }
    },
    {
      "id": "r_dessert",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "s_dessert", "path": "$.content[0].text" } } }
    },
    {
      "id": "budget",
      "tool": "everything__get-sum",
      "args": { "a": 1200, "b": 800 }
    },
    {
      "id": "eta",
      "tool": "everything__get-sum",
      "args": { "a": 25, "b": 10 }
    },
    {
      "id": "context",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "start", "path": "$.content[0].text" } } }
    },
    {
      "id": "mains",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "r_pizza", "path": "$.content[0].text" } } },
      "dependsOn": ["r_sushi", "r_biryani", "r_burger"]
    },
    {
      "id": "sides",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "r_chinese", "path": "$.content[0].text" } } },
      "dependsOn": ["r_dessert"]
    },
    {
      "id": "shortlist",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "mains", "path": "$.content[0].text" } } },
      "dependsOn": ["sides", "budget", "eta"],
      "breakpoint": true
    },
    {
      "id": "promo",
      "tool": "everything__echo",
      "args": { "message": "Applied FOODIE20 (-20%)" }
    },
    {
      "id": "addr_confirm",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "addr_view", "path": "$.content[0].text" } } }
    },
    {
      "id": "confirm",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "shortlist", "path": "$.content[0].text" } } },
      "dependsOn": ["promo", "addr_confirm", "context"]
    },
    {
      "id": "notify",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "confirm", "path": "$.content[0].text" } } }
    },
    {
      "id": "done",
      "tool": "everything__echo",
      "args": { "message": { "$ref": { "nodeId": "notify", "path": "$.content[0].text" } } },
      "breakpoint": true
    }
  ]
}
