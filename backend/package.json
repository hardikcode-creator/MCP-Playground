{
  "name": "mcp-playground-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Backend proxy + workflow engine for MCP Playground",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "serve": "tsx src/server/index.ts",
    "dev:serve": "tsx watch src/server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
