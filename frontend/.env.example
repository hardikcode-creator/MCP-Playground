# Backend transport switch.
#
# Unset (or blank) -> the app uses the in-browser mock client (no backend).
# Set to the backend WebSocket URL to drive the real ClientManager + executor:
#
#   1. cd ../backend && npm install && npm run serve   # listens on ws://localhost:8787
#   2. cp .env.example .env  (in this frontend folder) and keep the line below
#   3. npm run dev
#
VITE_MCP_WS_URL=ws://localhost:8787
