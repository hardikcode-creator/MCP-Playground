{
  "name": "mcp-playground-ai-services",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AI services for MCP Playground — LLM-powered argument mapping between workflow nodes (Ollama via the OpenAI SDK)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "serve": "tsx src/server/http.ts",
    "serve:watch": "tsx watch src/server/http.ts",
    "demo": "tsx src/cli/demo.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
